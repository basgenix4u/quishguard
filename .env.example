# === Database ===
DATABASE_URL=postgresql+asyncpg://quishguard:quishguard_dev@localhost:5432/quishguard_db
DATABASE_URL_SYNC=postgresql+psycopg2://quishguard:quishguard_dev@localhost:5432/quishguard_db

# === Application ===
APP_NAME=QuishGuard
APP_VERSION=0.1.0
DEBUG=true
API_V1_PREFIX=/api/v1

# === Security ===
SECRET_KEY=change-me-to-a-secure-random-string-in-production
API_KEY_PREFIX=qg_live_
ENCRYPTION_ALGORITHM=HS256

# === File Upload ===
MAX_FILE_SIZE_MB=10
UPLOAD_DIR=./uploads
ALLOWED_EXTENSIONS=png,jpg,jpeg,webp

# === Rate Limiting ===
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=100

# === Threat Intelligence (Optional — leave blank to skip) ===
GOOGLE_SAFE_BROWSING_API_KEY=
GOOGLE_SAFE_BROWSING_CLIENT_ID=quishguard
URLSCAN_API_KEY=

# === ML Models ===
AI_DETECTOR_MODEL_PATH=./models_pretrained/ai_detector_efficientnet_b4.pt
URL_CLASSIFIER_MODEL_PATH=./models_pretrained/url_classifier_xgboost.pkl
QR_TAMPERING_MODEL_PATH=./models_pretrained/qr_tampering_resnet18.pt

# === CORS ===
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# === Logging ===
LOG_LEVEL=INFO
